# Optional local music connector configuration.
# The connector only listens on the local machine by default.
MEMENTO_MUSIC_HOST=127.0.0.1
MEMENTO_MUSIC_PORT=3000

# Browser-side override for a separately hosted local connector.
# Do not put account cookies, API keys, or tokens in this file.
VITE_MUSIC_API_BASE_URL=http://127.0.0.1:3000
