{
  "name": "memento-memory-universe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MEMENTO：一个在浏览器本地组织、探索与备份个人记忆关系的空间产品。",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "demo:generate": "node scripts/generate-demo-data.mjs",
    "music:library": "node scripts/generate-music-library.mjs",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.7.0",
    "camera-controls": "3.1.2",
    "class-variance-authority": "0.7.1",
    "exifreader": "4.41.3",
    "fast-average-color": "9.5.2",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "mediabunny": "^1.53.0",
    "pica": "10.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "three": "0.185.0",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.3",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "fake-indexeddb": "6.2.5",
    "globals": "16.5.0",
    "jsdom": "27.2.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "7.2.4",
    "vitest": "4.0.13"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.9.0"
}
